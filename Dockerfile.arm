## package #####################################################################

FROM golang:1.26.10 AS package

# Add backports to get upx-ucl in Bookworm
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list && \
    apt-get update && apt-get install -y -t bookworm-backports upx-ucl

WORKDIR /go/src/github.com/convox/rack

COPY . /go/src/github.com/convox/rack
RUN make build compress

## production ##################################################################

FROM ubuntu:24.04 AS fetch

ARG DOCKER_ARCH=aarch64
ARG DOCKER_VERSION=29.9.2
ARG BUILDX_VERSION=0.38.1

RUN apt-get -qq update && apt-get -qq -y install curl ca-certificates

RUN curl -fsSL https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_VERSION}.tgz | \
    tar -C /usr/bin --strip-components 1 -xz docker/docker

# Install docker-buildx plugin (required by Docker 29.x for BuildKit builds)
RUN mkdir -p /usr/local/lib/docker/cli-plugins && \
    BUILDX_ARCH=$(case ${DOCKER_ARCH} in x86_64) echo amd64;; aarch64) echo arm64;; esac) && \
    curl -fsSL https://github.com/docker/buildx/releases/download/v${BUILDX_VERSION}/buildx-v${BUILDX_VERSION}.linux-${BUILDX_ARCH} \
      -o /usr/local/lib/docker/cli-plugins/docker-buildx && \
    chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx

FROM gcr.io/distroless/static-debian13

COPY --from=fetch /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=fetch /usr/bin/docker /usr/bin/
COPY --from=fetch /usr/local/lib/docker/cli-plugins/docker-buildx /usr/local/lib/docker/cli-plugins/

ENV DEVELOPMENT=false
ENV GOPATH=/go
ENV PATH=$PATH:/go/bin

WORKDIR /rack

COPY --from=package /go/bin/build /go/bin/
COPY --from=package /go/bin/convox-env /go/bin/
COPY --from=package /go/bin/monitor /go/bin/
COPY --from=package /go/bin/rack /go/bin/

# aws templates
COPY --from=package /go/src/github.com/convox/rack/provider/aws/formation/ provider/aws/formation/
COPY --from=package /go/src/github.com/convox/rack/provider/aws/templates/ provider/aws/templates/

CMD ["/go/bin/rack"]
